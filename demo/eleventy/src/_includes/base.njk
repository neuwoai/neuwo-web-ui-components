<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="data:,">
    <title>{{ title }}</title>
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/neuwo/fonts/noto-sans-variable.woff2">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/neuwo/fonts/outfit-variable.woff2">
    <link rel="stylesheet" href="/neuwo/neuwo.css">
    <link rel="stylesheet" href="/page.css">
    <script type="module" src="/neuwo/neuwo.js"></script>
  </head>
  <body class="neuwo-body">
    <div class="background">
      <div class="neuwo-background__gradient"></div>
    </div>
    <div class="shell">
      <neuwo-sidebar current="{{ page.url }}" remember>
        <a slot="brand" href="/"><neuwo-logo variant="bg-dark"></neuwo-logo></a>
        <neuwo-nav-item href="/">Sign Up</neuwo-nav-item>
        <neuwo-nav-section label="Layout">
          <neuwo-nav-item href="/second/">Second Page</neuwo-nav-item>
        </neuwo-nav-section>
        <neuwo-nav-section label="Resources">
          <neuwo-nav-item href="https://github.com/neuwoai/neuwo-web-ui-components">Source Code</neuwo-nav-item>
          <neuwo-nav-item href="https://www.npmjs.com/package/@neuwo/web-ui-library--demo">Package on npm</neuwo-nav-item>
        </neuwo-nav-section>
        <a slot="footer" href="https://neuwo.ai/">Back to neuwo.ai</a>
      </neuwo-sidebar>
      <main class="page">
        {{ content | safe }}
      </main>
    </div>
  </body>
</html>

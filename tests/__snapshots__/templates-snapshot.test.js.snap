exports[`template markup snapshots > neuwo-button > link 1`] = `"<neuwo-button href="https://neuwo.ai" target="_blank" rel="noopener" download=""><a class="neuwo-btn neuwo-btn--solid" href="https://neuwo.ai" target="_blank" rel="noopener" download=""><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Visit</span><span class="neuwo-btn__end"></span></a></neuwo-button>"`;

exports[`template markup snapshots > neuwo-button > loading 1`] = `"<neuwo-button type="submit" loading=""><button class="neuwo-btn neuwo-btn--solid neuwo-btn--loading" type="submit" disabled="" aria-busy="true"><span class="neuwo-btn__spinner" aria-hidden="true"></span><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Saving</span><span class="neuwo-btn__end"></span></button></neuwo-button>"`;


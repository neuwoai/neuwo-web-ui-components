exports[`template markup snapshots > neuwo-button > start icon and forwarded attributes 1`] = `"<neuwo-button title="Add" aria-label="Add item" data-track="add"><button class="neuwo-btn neuwo-btn--solid" type="button" title="Add" aria-label="Add item" data-track="add"><span class="neuwo-btn__start"><span slot="start">+</span></span><span class="neuwo-btn__label">Add</span><span class="neuwo-btn__end"></span></button></neuwo-button>"`;

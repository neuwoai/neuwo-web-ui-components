exports[`template markup snapshots > neuwo-radio-group > a disabled group 1`] = `"<neuwo-radio-group name="plan" value="a" disabled="" aria-label="Plan" title="Plan" data-x="1" no-error-line=""><div class="neuwo-choice neuwo-choice--flush"><div class="neuwo-radio-group" role="radiogroup" aria-orientation="vertical" aria-label="Plan" title="Plan"><span class="neuwo-radio-group__legend" id="neuwo-s1-legend" hidden=""></span><div class="neuwo-radio-group__options"><neuwo-radio value="a"><label class="neuwo-form-check"><input class="neuwo-form-check__input" type="radio" name="plan" value="a" checked="" disabled=""><span class="neuwo-form-check__label">A</span></label></neuwo-radio><neuwo-radio value="b"><label class="neuwo-form-check"><input class="neuwo-form-check__input" type="radio" name="plan" value="b" disabled=""><span class="neuwo-form-check__label">B</span></label></neuwo-radio></div></div></div></neuwo-radio-group>"`;


exports[`template markup snapshots > neuwo-notice > filled close button 1`] = `"<neuwo-notice position="static" dismissible="" dismiss-filled=""><div class="neuwo-notice neuwo-notice--dismissible" role="status"><div class="neuwo-notice__content"><div class="neuwo-notice__title"><span slot="title">New release</span></div><div class="neuwo-notice__message neuwo-notice__message--empty"></div></div><div class="neuwo-notice__actions neuwo-notice__actions--empty"></div><button class="neuwo-notice__dismiss neuwo-notice__dismiss--filled" type="button" aria-label="Dismiss"></button></div></neuwo-notice>"`;

exports[`template markup snapshots > neuwo-notice > indented consent banner 1`] = `
"<neuwo-notice position="bottom-center" layout="row" role="dialog" aria-label="Cookies"><div class="neuwo-notice neuwo-notice--fixed neuwo-notice--bottom neuwo-notice--center neuwo-notice--row"><div class="neuwo-notice__content"><div class="neuwo-notice__title"><span slot="title">We use cookies</span></div><div class="neuwo-notice__message">
  
  We use analytics cookies.
  
  
</div></div><div class="neuwo-notice__actions"><neuwo-button slot="actions" variant="glass" size="sm"><button class="neuwo-btn neuwo-btn--glass neuwo-btn--sm" type="button"><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Reject</span><span class="neuwo-btn__end"></span></button></neuwo-button><neuwo-button slot="actions" size="sm"><button class="neuwo-btn neuwo-btn--solid neuwo-btn--sm" type="button"><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Accept</span><span class="neuwo-btn__end"></span></button></neuwo-button></div></div></neuwo-notice>"
`;


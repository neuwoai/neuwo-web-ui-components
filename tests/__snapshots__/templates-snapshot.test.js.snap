exports[`template markup snapshots > neuwo-radio > a lone radio 1`] = `"<neuwo-radio name="agree" value="yes" checked="" required="" form="signup" aria-label="Agree" title="Agree" data-x="1"><label class="neuwo-form-check"><input class="neuwo-form-check__input" type="radio" name="agree" value="yes" checked="" required="" form="signup" aria-label="Agree" title="Agree"><span class="neuwo-form-check__label">I <em>agree</em></span></label></neuwo-radio>"`;


exports[`template markup snapshots > neuwo-button > outline large 1`] = `"<neuwo-button variant="outline" size="lg"><button class="neuwo-btn neuwo-btn--outline neuwo-btn--lg" type="button"><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Contact us</span><span class="neuwo-btn__end"></span></button></neuwo-button>"`;


exports[`template markup snapshots > neuwo-button > block 1`] = `"<neuwo-button block="" hover="l" xwide=""><button class="neuwo-btn neuwo-btn--solid neuwo-btn--hover-l neuwo-btn--xwide neuwo-btn--block" type="button"><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Full width</span><span class="neuwo-btn__end"></span></button></neuwo-button>"`;

exports[`template markup snapshots > neuwo-button > disabled link 1`] = `"<neuwo-button href="https://neuwo.ai" disabled=""><button class="neuwo-btn neuwo-btn--solid" type="button" disabled=""><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Visit</span><span class="neuwo-btn__end"></span></button></neuwo-button>"`;

exports[`template markup snapshots > neuwo-button > end svg 1`] = `"<neuwo-button size="sm" hover="s" wide=""><button class="neuwo-btn neuwo-btn--solid neuwo-btn--sm neuwo-btn--hover-s neuwo-btn--wide" type="button"><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Next</span><span class="neuwo-btn__end"><svg slot="end"><path d="M0 0"></path></svg></span></button></neuwo-button>"`;


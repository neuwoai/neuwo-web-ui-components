exports[`template markup snapshots > neuwo-cta > spotlight with a loud pulse 1`] = `"<neuwo-cta variant="spotlight" pulse="" intensity="l"><div class="neuwo-cta neuwo-cta--spotlight"><div class="neuwo-cta__glow" aria-hidden="true"></div><div class="neuwo-cta__inner"><div class="neuwo-cta__body"><h2 class="neuwo-cta__headline">Ready to <span data-accent="">earn more</span> from your content?</h2><div class="neuwo-cta__sub"><span slot="sub">Talk to our team about monetisation.</span></div><div class="neuwo-cta__field neuwo-cta__field--empty"></div><p class="neuwo-cta__status" role="status" aria-live="polite"></p></div><div class="neuwo-cta__actions"><neuwo-button slot="actions" size="lg"><button class="neuwo-btn neuwo-btn--solid neuwo-btn--lg" type="button"><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">Contact us</span><span class="neuwo-btn__end"></span></button></neuwo-button><neuwo-button slot="actions" variant="outline" size="lg"><button class="neuwo-btn neuwo-btn--outline neuwo-btn--lg" type="button"><span class="neuwo-btn__start"></span><span class="neuwo-btn__label">See pricing</span><span class="neuwo-btn__end"></span></button></neuwo-button></div></div></div></neuwo-cta>"`;


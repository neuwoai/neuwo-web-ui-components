{
  "name": "@neuwo/web-ui-components",
  "version": "0.0.0",
  "description": "Neuwo design-system web components (vanilla custom elements).",
  "type": "module",
  "types": "./dist/types/elements.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": { "types": "./dist/types/elements.d.ts", "default": "./dist/neuwo.js" },
    "./neuwo.css": "./dist/neuwo.css",
    "./foundation/*": "./dist/foundation/*",
    "./components/*": "./dist/components/*",
    "./fonts/*": "./dist/fonts/*",
    "./logos/*": "./dist/logos/*",
    "./package.json": "./package.json"
  },
  "private": true,
  "scripts": {
    "start": "node scripts/build.js --serve",
    "build": "node scripts/build.js && npm run analyze && npm run types",
    "analyze": "cem analyze",
    "pretest": "npm run analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.10",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "customElements": "custom-elements.json"
}

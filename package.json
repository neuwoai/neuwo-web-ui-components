{
  "name": "@neuwo/web-ui-library--demo",
  "version": "0.1.0",
  "description": "Neuwo Web UI Library: vanilla custom elements and published CSS recipes for the Neuwo design language.",
  "keywords": [
    "neuwo",
    "web-components",
    "custom-elements",
    "design-system",
    "design-tokens",
    "css"
  ],
  "homepage": "https://designsystem.neuwo.ai",
  "license": "MIT",
  "author": "Neuwo",
  "type": "module",
  "types": "./dist/types/elements.d.ts",
  "files": [
    "dist",
    "custom-elements.json",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": { "types": "./dist/types/elements.d.ts", "default": "./dist/neuwo.js" },
    "./server": { "types": "./dist/server/index.d.ts", "default": "./dist/server.js" },
    "./jsx-runtime": { "types": "./dist/types/jsx-runtime.d.ts", "react-server": "./dist/jsx-runtime.react-server.js", "default": "./dist/jsx-runtime.js" },
    "./jsx-dev-runtime": { "types": "./dist/types/jsx-dev-runtime.d.ts", "react-server": "./dist/jsx-dev-runtime.react-server.js", "default": "./dist/jsx-dev-runtime.js" },
    "./neuwo.css": "./dist/neuwo.css",
    "./neuwo-components.css": "./dist/neuwo-components.css",
    "./foundation/*": "./dist/foundation/*",
    "./components/*": "./dist/components/*",
    "./fonts/*": "./dist/fonts/*",
    "./logos/*": "./dist/logos/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node scripts/build.js --serve",
    "build": "node scripts/build.js && npm run analyze && npm run types && npm run types:jsx",
    "analyze": "cem analyze",
    "pretest": "npm run analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc -p tsconfig.json",
    "types:jsx": "node scripts/jsx-types.js && tsc -p tests/react/tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.10",
    "@types/react": "^19.3.0",
    "domhandler": "^6.0.1",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.3",
    "htmlparser2": "^12.0.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "customElements": "custom-elements.json"
}
